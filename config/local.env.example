# 本地开发配置示例。复制为 .env 后用 `set -a; source .env; set +a` 载入，
# 或直接在命令前加环境变量。所有键均可省略，省略时使用内置默认值。

# 监听地址。默认只绑回环，避免本机服务暴露到局域网。
CNF_HTTP_BIND=127.0.0.1:8080

# 每请求决策预算。-1 = 不限；0 = 只允许单位传播（强 UNKNOWN 压力测试）。
CNF_MAX_DECISIONS=100000

# 每请求墙钟预算（毫秒）。-1 = 不限。
CNF_TIME_LIMIT_MS=1000

# 日志格式：text（人读）或 json（结构化）。
CNF_LOG_FORMAT=text

# tracing 过滤指令（可选）。
RUST_LOG=info
