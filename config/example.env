# 最小配置示例（KEY=VALUE）。也可改用同名环境变量，环境变量以 REORG_ 为前缀。
# 用法：reorgindex serve 读取需通过环境变量；replay/rebuild-check 用命令行参数。

# SQLite 数据库路径
REORG_DB_PATH=data/reorgindex.sqlite3

# 最终性深度 D：确认数 >= D+1 的区块视为最终确定；
# 回滚数量 > D 的重组一律拒绝。max_reorg_depth 恒等于此值。
REORG_FINALITY_DEPTH=6

# 权重相等时是否保留当前权威链（1=保留，不切换）
REORG_TIE_KEEP_CANONICAL=1

# 日志级别与脱敏保留字符数
REORG_LOG_LEVEL=INFO
REORG_REDACT_KEEP=6
