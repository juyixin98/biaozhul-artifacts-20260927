{
  "default_profile": "standard",
  "profiles": [
    {
      "name": "standard",
      "version": "2026.09.1",
      "description": "合成日志标准脱敏档：卡号/手机号/令牌/工号/邮箱 + JSON 敏感字段（提示即放行尾部）",
      "on_ambiguous_tail": "mark",
      "field_rule": {
        "id": "field-secrets",
        "description": "JSON 键名为敏感字段的字符串/数字值",
        "priority": 10,
        "keys": [
          "password",
          "secret",
          "api_key",
          "token"
        ],
        "max_value_length": 256,
        "replacement": "<FIELD>"
      },
      "rules": [
        {
          "id": "bank-card-16",
          "description": "16 位银行卡号（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<![A-Za-z0-9_])\\d{16}(?![A-Za-z0-9_])",
          "max_length": 16,
          "replacement": "<BANK_CARD>",
          "prefix_hint": "\\d{1,16}$",
          "tail_suspicion": "\\d{10,16}$"
        },
        {
          "id": "cn-mobile-11",
          "description": "中国大陆 11 位手机号（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
          "max_length": 11,
          "replacement": "<MOBILE>",
          "prefix_hint": "\\d{1,11}$",
          "tail_suspicion": "1[3-9]\\d{8,9}$"
        },
        {
          "id": "api-token-32",
          "description": "32 位字母数字令牌（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<![A-Za-z0-9])[A-Za-z0-9]{32}(?![A-Za-z0-9])",
          "max_length": 32,
          "replacement": "<TOKEN>",
          "prefix_hint": "[A-Za-z0-9]{1,32}$",
          "tail_suspicion": "[A-Za-z0-9]{12,32}$"
        },
        {
          "id": "emp-id",
          "description": "员工工号 EMP-xxxxxx（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "EMP-\\d{6}",
          "max_length": 10,
          "replacement": "<EMP_ID>",
          "prefix_hint": "(?:E|EM|EMP|EMP-\\d{0,6})$",
          "tail_suspicion": "(?:EMP|EMP-\\d{1,6})$"
        },
        {
          "id": "email",
          "description": "邮箱地址（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "max_length": 254,
          "replacement": "<EMAIL>",
          "prefix_hint": "[A-Za-z0-9._%+-]{1,64}(?:@[A-Za-z0-9.-]{0,253})?$",
          "tail_suspicion": "[A-Za-z0-9._%+-]{6,}@[A-Za-z0-9.-]{0,253}$"
        }
      ]
    },
    {
      "name": "strict",
      "version": "2026.09.1",
      "description": "严格档：扩大 JSON 敏感字段集合，尾部疑似前缀按失败处理",
      "on_ambiguous_tail": "error",
      "field_rule": {
        "id": "field-secrets-strict",
        "description": "JSON 键名为敏感字段的字符串/数字值（严格档）",
        "priority": 10,
        "keys": [
          "password",
          "secret",
          "api_key",
          "token",
          "id_card",
          "card_no"
        ],
        "max_value_length": 256,
        "replacement": "<FIELD>"
      },
      "rules": [
        {
          "id": "bank-card-16",
          "description": "16 位银行卡号（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<![A-Za-z0-9_])\\d{16}(?![A-Za-z0-9_])",
          "max_length": 16,
          "replacement": "<BANK_CARD>",
          "prefix_hint": "\\d{1,16}$",
          "tail_suspicion": "\\d{10,16}$"
        },
        {
          "id": "cn-mobile-11",
          "description": "中国大陆 11 位手机号（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
          "max_length": 11,
          "replacement": "<MOBILE>",
          "prefix_hint": "\\d{1,11}$",
          "tail_suspicion": "1[3-9]\\d{8,9}$"
        },
        {
          "id": "api-token-32",
          "description": "32 位字母数字令牌（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "(?<![A-Za-z0-9])[A-Za-z0-9]{32}(?![A-Za-z0-9])",
          "max_length": 32,
          "replacement": "<TOKEN>",
          "prefix_hint": "[A-Za-z0-9]{1,32}$",
          "tail_suspicion": "[A-Za-z0-9]{12,32}$"
        },
        {
          "id": "emp-id",
          "description": "员工工号 EMP-xxxxxx（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "EMP-\\d{6}",
          "max_length": 10,
          "replacement": "<EMP_ID>",
          "prefix_hint": "(?:E|EM|EMP|EMP-\\d{0,6})$",
          "tail_suspicion": "(?:EMP|EMP-\\d{1,6})$"
        },
        {
          "id": "email",
          "description": "邮箱地址（合成）",
          "type": "pattern",
          "priority": 20,
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "max_length": 254,
          "replacement": "<EMAIL>",
          "prefix_hint": "[A-Za-z0-9._%+-]{1,64}(?:@[A-Za-z0-9.-]{0,253})?$",
          "tail_suspicion": "[A-Za-z0-9._%+-]{6,}@[A-Za-z0-9.-]{0,253}$"
        }
      ]
    }
  ]
}