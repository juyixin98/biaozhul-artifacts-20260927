{
  "fixture_set": "three-way-merge v1",
  "description": "Hand-authored synthetic three-way merge fixtures. Expected answers are explicit literals, never generated by the core. Line terminators are part of the JSON string values (\\n, \\r\\n).",
  "cases": [
    {
      "case_id": "move_disjoint",
      "description": "Local swaps two similar leading paragraphs; remote edits an unrelated paragraph and appends a line. Disjoint: both survive.",
      "base": "p1\np2\np3\np4\np5\np6\n",
      "local": "p2\np1\np3\np4\np5\np6\n",
      "remote": "p1\np2\np3\np4\np5\nP6SIX\ntail\n",
      "expect": {"auto": true, "merged_text": "p2\np1\np3\np4\np5\nP6SIX\ntail\n"}
    },
    {
      "case_id": "duplicate_lines_disjoint",
      "description": "Two distinct occurrences inside a run of identical 'r' lines edited by different sides; positions are disjoint.",
      "base": "r\nr\nr\nr\n",
      "local": "r\nL1\nr\nr\n",
      "remote": "r\nr\nR1\nr\n",
      "expect": {"auto": true, "merged_text": "r\nL1\nR1\nr\n"}
    },
    {
      "case_id": "duplicate_lines_same_spot",
      "description": "Both sides replace the same occurrence in a repeated-line run differently.",
      "base": "r\nr\nr\nr\n",
      "local": "r\nX\nr\nr\n",
      "remote": "r\nY\nr\nr\n",
      "expect": {"auto": false, "conflict_types": ["divergent_modify"]}
    },
    {
      "case_id": "same_point_insert_conflict",
      "description": "Different lines inserted at the identical top boundary.",
      "base": "h1\nh2\nh3\n",
      "local": "INS-L\nh1\nh2\nh3\n",
      "remote": "INS-R\nh1\nh2\nh3\n",
      "expect": {
        "auto": false,
        "conflict_types": ["same_point_insert"],
        "resolutions": {
          "local": "INS-L\nh1\nh2\nh3\n",
          "remote": "INS-R\nh1\nh2\nh3\n",
          "base": "h1\nh2\nh3\n",
          "local_then_remote": "INS-L\nINS-R\nh1\nh2\nh3\n",
          "remote_then_local": "INS-R\nINS-L\nh1\nh2\nh3\n"
        }
      }
    },
    {
      "case_id": "point_inserts_different_boundaries",
      "description": "Inserts at different boundaries (top and end) are disjoint.",
      "base": "h1\nh2\nh3\n",
      "local": "INS-L\nh1\nh2\nh3\n",
      "remote": "h1\nh2\nh3\nEND\n",
      "expect": {"auto": true, "merged_text": "INS-L\nh1\nh2\nh3\nEND\n"}
    },
    {
      "case_id": "same_point_insert_identical",
      "description": "Identical insert at the same point is taken once.",
      "base": "h1\nh2\nh3\n",
      "local": "INS-L\nh1\nh2\nh3\n",
      "remote": "INS-L\nh1\nh2\nh3\n",
      "expect": {"auto": true, "merged_text": "INS-L\nh1\nh2\nh3\n"}
    },
    {
      "case_id": "delete_modify",
      "description": "Local deletes beta; remote changes it.",
      "base": "alpha\nbeta\ngamma\ndelta\n",
      "local": "alpha\ngamma\ndelta\n",
      "remote": "alpha\nBETA!\ngamma\ndelta\n",
      "expect": {
        "auto": false,
        "conflict_types": ["delete_modify"],
        "resolutions": {
          "local": "alpha\ngamma\ndelta\n",
          "remote": "alpha\nBETA!\ngamma\ndelta\n",
          "base": "alpha\nbeta\ngamma\ndelta\n"
        }
      }
    },
    {
      "case_id": "crlf_preserved",
      "description": "All CRLF; the merge must not normalize to LF.",
      "base": "one\r\ntwo\r\nthree\r\n",
      "local": "one\r\nTWO\r\nthree\r\n",
      "remote": "one\r\ntwo\r\nthree\r\nfour\r\n",
      "expect": {"auto": true, "merged_text": "one\r\nTWO\r\nthree\r\nfour\r\n"}
    },
    {
      "case_id": "no_trailing_newline_preserved",
      "description": "No document ends with a newline; the result must not gain one.",
      "base": "a\nb\nc",
      "local": "a\nb\nc\nd",
      "remote": "A\nb\nc",
      "expect": {"auto": true, "merged_text": "A\nb\nc\nd"}
    },
    {
      "case_id": "mixed_eol_preserved",
      "description": "Mixed LF and CRLF in one document each keep their form.",
      "base": "u\nv\r\nw\n",
      "local": "U\nv\r\nw\n",
      "remote": "u\nv\r\nw\nz\r\n",
      "expect": {"auto": true, "merged_text": "U\nv\r\nw\nz\r\n"}
    },
    {
      "case_id": "partial_overlap",
      "description": "Local replaces lines [1,3); remote replaces line 2: overlap without coinciding.",
      "base": "l1\nl2\nl3\nl4\nl5\n",
      "local": "l1\nX\nY\nl4\nl5\n",
      "remote": "l1\nl2\nZ\nl4\nl5\n",
      "expect": {"auto": false, "conflict_types": ["partial_overlap"]}
    },
    {
      "case_id": "insert_strictly_inside_range",
      "description": "Remote inserts at a boundary strictly inside local's replaced span.",
      "base": "a\nb\nc\nd\n",
      "local": "a\nB\nC\nd\n",
      "remote": "a\nb\nINS\nc\nd\n",
      "expect": {"auto": false, "conflict_types": ["insert_range"]}
    }
  ]
}
