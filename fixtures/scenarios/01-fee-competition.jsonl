# 场景 1：多账户费用竞争、nonce 排序、余额变化、确认
# 事件索引从 0 开始；at 为 Unix 秒（虚拟时钟）。
# 金额为 wei。gas_limit 未标注时默认 21000（纯转账固有 gas）。
{"at": 1000, "type": "fund", "account": "alice", "key": "0x4ccdaaedd8447b0e39d1de94324d02b033925062cbb07a69c41d2c341c4e7edc", "balance": 1000000000000000000}
{"at": 1000, "type": "fund", "account": "bob",   "key": "0xd8a40a40c55a027c519ae103de5974275f7a97d85467b5f4f3967323db4da1da", "balance": 500000000000000000}
{"at": 1000, "type": "fund", "account": "carol", "key": "0x8f7f8f62c85ee8a74b3c7b2517c9c237f11cd328290ccdffd361e33dfb29672e", "balance": 100000000000000000}
{"at": 1000, "type": "fund", "account": "dave",  "key": "0x0fdd7f451590a75c97476006e2ff0874b579dad8d9f24899fcef60173354d9d5", "balance": 200000000000000000}
{"at": 1000, "type": "fund", "account": "miner", "key": "0x49a7118de07277fe2e896997acf11284067aaebba144757100054a65cff72ec8", "balance": 0}
# Alice：两笔连续 nonce，不同价格
{"at": 1010, "type": "tx", "label": "a1", "account": "alice", "nonce": 0, "to": "bob",   "gas_price": 10, "value": 1000}
{"at": 1011, "type": "tx", "label": "a2", "account": "alice", "nonce": 1, "to": "carol", "gas_price": 90, "value": 2000}
# Bob：中价
{"at": 1012, "type": "tx", "label": "b1", "account": "bob",   "nonce": 0, "to": "carol", "gas_price": 40, "value": 500}
# Carol：最高价
{"at": 1013, "type": "tx", "label": "c1", "account": "carol", "nonce": 0, "to": "dave",  "gas_price": 100, "value": 100}
# Dave 只有 0.2 ether：21000*100=2,100,000 + value，负担得起
{"at": 1014, "type": "tx", "label": "d1", "account": "dave",  "nonce": 0, "to": "alice", "gas_price": 5,  "value": 100}
{"at": 1015, "type": "snapshot"}
# 候选顺序：价高者得，但 Alice 的 nonce1 不得越过 nonce0
{"at": 1020, "type": "propose", "coinbase": "miner"}
{"at": 1021, "type": "snapshot"}
# 确认：余额、nonce、coinbase 手续费全部落账
{"at": 1030, "type": "confirm"}
{"at": 1031, "type": "snapshot"}
