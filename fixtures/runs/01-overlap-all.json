{
  "run_id": "case-01-overlap-all",
  "description": "Two overlapping triggers (steps 0 and 1); one response at step 2 lies inside both closed windows [0,2] and [1,3], and satisfy=all lets the single event discharge both obligations.",
  "closed": true,
  "ruleset": {
    "version": "v1",
    "response": [
      {
        "id": "pay_after_order",
        "trigger": { "all": [ { "field": "kind", "op": "eq", "value": "order" } ] },
        "response": { "field": "kind", "op": "eq", "value": "payment" },
        "after": 0,
        "within": 3,
        "satisfy": "all"
      }
    ]
  },
  "events": [
    { "kind": "order", "seq": 1 },
    { "kind": "order", "seq": 2 },
    { "kind": "payment", "seq": 3 },
    { "kind": "close_day" }
  ]
}
