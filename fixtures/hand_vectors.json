{
  "meta": {
    "description": "Hand-computed EIP-1559-style vectors. Every expected value here was derived by hand with integer arithmetic and the arithmetic scratch is recorded in 'scratch' so a reviewer can re-do it. Not generated by the kernel.",
    "fixed_parameters": {
      "elasticity_multiplier": 2,
      "target_gas(gas_limit=30000000)": 15000000,
      "base_fee_max_change_denominator": 8,
      "min_base_fee": 0,
      "division": "floor (//), two sequential floors; upward path pins delta to a minimum of 1 wei"
    }
  },
  "base_fee_vectors": [
    {
      "name": "target-load leaves fee unchanged",
      "parent_base_fee": 1000000000,
      "gas_used": 15000000,
      "gas_limit": 30000000,
      "expected_direction": "flat",
      "expected_delta_numerator": 0,
      "expected_delta_final": 0,
      "expected_next_base_fee": 1000000000,
      "scratch": "gap=0 => delta=0 => 1_000_000_000"
    },
    {
      "name": "empty block: max downward step 1/8",
      "parent_base_fee": 1000000000,
      "gas_used": 0,
      "gas_limit": 30000000,
      "expected_direction": "down",
      "expected_delta_numerator": 15000000000000000,
      "expected_delta_after_first_floor": 1000000000,
      "expected_delta_final": 125000000,
      "expected_next_base_fee": 875000000,
      "scratch": "gap=target=15_000_000; num=1e9*15m=15e15; //target = 1e9; //8 = 125_000_000; 1_000_000_000-125_000_000 = 875_000_000"
    },
    {
      "name": "full block: max upward step 1/8",
      "parent_base_fee": 1000000000,
      "gas_used": 30000000,
      "gas_limit": 30000000,
      "expected_direction": "up",
      "expected_delta_numerator": 15000000000000000,
      "expected_delta_after_first_floor": 1000000000,
      "expected_delta_final": 125000000,
      "expected_next_base_fee": 1125000000,
      "scratch": "gap=15m; num=1e9*15m=15e15; //15m = 1e9; //8 = 125_000_000; fee=1_125_000_000"
    },
    {
      "name": "75% full: half of max upward step",
      "parent_base_fee": 1000000000,
      "gas_used": 22500000,
      "gas_limit": 30000000,
      "expected_direction": "up",
      "expected_delta_numerator": 7500000000000000,
      "expected_delta_after_first_floor": 500000000,
      "expected_delta_final": 62500000,
      "expected_next_base_fee": 1062500000,
      "scratch": "gap=7.5m; num=1e9*7.5m=7.5e15; //15m = 5e8; //8=62.5m"
    },
    {
      "name": "25% full: half of max downward step",
      "parent_base_fee": 1000000000,
      "gas_used": 7500000,
      "gas_limit": 30000000,
      "expected_direction": "down",
      "expected_delta_numerator": 7500000000000000,
      "expected_delta_after_first_floor": 500000000,
      "expected_delta_final": 62500000,
      "expected_next_base_fee": 937500000,
      "scratch": "gap=7.5m; //15m=5e8; //8=62.5m; fee=937_500_000"
    },
    {
      "name": "empty at tiny fee 7: floor pin then stuck at 7",
      "parent_base_fee": 7,
      "gas_used": 0,
      "gas_limit": 30000000,
      "expected_direction": "down",
      "expected_delta_numerator": 105000000,
      "expected_delta_after_first_floor": 7,
      "expected_delta_final": 0,
      "expected_next_base_fee": 7,
      "scratch": "num=7*15m=105m; //15m=7; //8=0; fee=7-0=7 (sticky; downward has no min-decrement rule)"
    },
    {
      "name": "above target at fee 1: minimum +1 wei increment",
      "parent_base_fee": 1,
      "gas_used": 30000000,
      "gas_limit": 30000000,
      "expected_direction": "up",
      "expected_delta_numerator": 15000000,
      "expected_delta_after_first_floor": 1,
      "expected_delta_final": 1,
      "expected_next_base_fee": 2,
      "applied_min_increment": true,
      "scratch": "num=1*15m=15m; //15m=1; //8=0 mathematically, but minimum-increment rule pins delta=1; fee=2"
    },
    {
      "name": "floor-division direction pin: num not divisible by target*8",
      "parent_base_fee": 100,
      "gas_used": 13,
      "gas_limit": 20,
      "expected_direction": "up",
      "expected_delta_numerator": 300,
      "expected_delta_after_first_floor": 30,
      "expected_delta_final": 3,
      "expected_next_base_fee": 103,
      "scratch": "target=10; gap=3; num=100*3=300; 300//10=30; 30//8=3 (floor, not 3.75->4). A ceiling/round rule would give 4."
    },
    {
      "name": "below target floor pin: sub-1-wei reduction vanishes",
      "parent_base_fee": 1,
      "gas_used": 9,
      "gas_limit": 20,
      "expected_direction": "down",
      "expected_delta_numerator": 1,
      "expected_delta_after_first_floor": 0,
      "expected_delta_final": 0,
      "expected_next_base_fee": 1,
      "scratch": "target=10; gap=1; num=1; 1//10=0; //8=0; fee stays 1"
    }
  ],
  "multi_block_vectors": [
    {
      "name": "six-block walk full/empty/target/75/25/empty from 1e9, limit 30m",
      "gas_limit": 30000000,
      "gas_used_sequence": [30000000, 0, 15000000, 22500000, 7500000, 0],
      "expected_base_fees_after": [
        1125000000,
        984375000,
        984375000,
        1045898437,
        980529785,
        857963562
      ],
      "scratch": [
        "B0=1_000_000_000",
        "full  : +B0/8=125_000_000 -> B1=1_125_000_000",
        "empty : -B1/8=140_625_000 -> B2=984_375_000",
        "target: no change -> B3=984_375_000",
        "75%   : num=B3*7.5m=7_382_812_500_000_000_000; //15m=492_187_500; //8=61_523_437 (492_187_500/8=61_523_437.5 floor); B4=1_045_898_437",
        "25%   : num=B4*7.5m=7_844_238_277_500_000_000; //15m=522_949_218; //8=65_368_652 (522_949_218/8=65_368_652.25 floor); B5=980_529_785",
        "empty : num=B5*15m; //15m=B5; //8=122_566_223 (980_529_785/8=122_566_223.125 floor); B6=857_963_562"
      ]
    }
  ],
  "transaction_vectors": [
    {
      "name": "tip is min(cap, slack); base burned, tip paid",
      "base_fee": 1000000000,
      "max_fee_per_gas": 1500000000,
      "max_priority_fee_per_gas": 100000000,
      "gas": 21000,
      "expected_effective_tip": 100000000,
      "expected_effective_price": 1100000000,
      "expected_burned": 21000000000000,
      "expected_tip_total": 2100000000000,
      "scratch": "slack=500m > cap=100m => tip=100m; price=1.1gwei; burn=21k*1gwei; tip=21k*100m"
    },
    {
      "name": "priority capped by slack when fee cap binds",
      "base_fee": 1000000000,
      "max_fee_per_gas": 1050000000,
      "max_priority_fee_per_gas": 300000000,
      "gas": 21000,
      "expected_effective_tip": 50000000,
      "expected_effective_price": 1050000000,
      "expected_burned": 21000000000000,
      "expected_tip_total": 1050000000000,
      "scratch": "slack=50m < cap=300m => tip=50m; pays exactly max_fee"
    },
    {
      "name": "max_fee equal to base fee: zero tip, valid",
      "base_fee": 1000000000,
      "max_fee_per_gas": 1000000000,
      "max_priority_fee_per_gas": 2000000000,
      "gas": 21000,
      "expected_effective_tip": 0,
      "expected_effective_price": 1000000000,
      "expected_burned": 21000000000000,
      "expected_tip_total": 0,
      "scratch": "slack=0 => tip=0 even though tip cap is 2 gwei; still includable"
    },
    {
      "name": "max_fee below base fee rejected",
      "base_fee": 1000000000,
      "max_fee_per_gas": 999999999,
      "max_priority_fee_per_gas": 100000000,
      "gas": 21000,
      "expected_valid": false,
      "expected_error_code": "E020_MAX_FEE_BELOW_BASE"
    },
    {
      "name": "gas below intrinsic 21000 rejected",
      "base_fee": 1000000000,
      "max_fee_per_gas": 2000000000,
      "max_priority_fee_per_gas": 100000000,
      "gas": 20999,
      "expected_valid": false,
      "expected_error_code": "E030_GAS_LIMIT_TOO_LOW"
    },
    {
      "name": "tip cap above fee cap is valid and auto-capped",
      "base_fee": 1000000000,
      "max_fee_per_gas": 1200000000,
      "max_priority_fee_per_gas": 5000000000,
      "gas": 21000,
      "expected_effective_tip": 200000000,
      "expected_effective_price": 1200000000,
      "expected_burned": 21000000000000,
      "expected_tip_total": 4200000000000,
      "scratch": "EIP-1559 permits tip_cap>fee_cap; tip=min(5gwei, 0.2gwei)=0.2gwei",
      "expected_warning_code": "W001_PRIORITY_CAP_ABOVE_FEE_CAP"
    },
    {
      "name": "overflow: max_fee*gas exceeds uint256",
      "base_fee": 1000000000,
      "max_fee_per_gas": 115792089237316195423570985008687907853269984665640564039457584007913129639935,
      "max_priority_fee_per_gas": 1,
      "gas": 21000,
      "expected_valid": false,
      "expected_error_code": "E032_FEE_OVERFLOW"
    },
    {
      "name": "conservation pricing: sender pays burned+tip, no ether created",
      "base_fee": 500000000,
      "max_fee_per_gas": 700000000,
      "max_priority_fee_per_gas": 150000000,
      "gas": 21000,
      "expected_effective_tip": 150000000,
      "expected_effective_price": 650000000,
      "expected_burned": 10500000000000,
      "expected_tip_total": 3150000000000,
      "expected_sender_debit": 13650000000000,
      "scratch": "price=0.65gwei; debit=21k*0.65gwei=13.65e12 = burn 10.5e12 + tip 3.15e12; slack (0.7-0.65)*21k stays with sender"
    }
  ]
}
