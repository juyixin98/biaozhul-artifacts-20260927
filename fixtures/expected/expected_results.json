{
  "_provenance": "本文件由测试作者手工编写，是被测内核之外的独立参考答案（oracle）。条目均不来自 app/ 实现；内核行为变更不得反向修改这些期望。url_template 中的 {port} 在测试中替换为本机演示上游实际端口。",
  "_grant_semantics": "grants 为 per-run 注入，一律排在静态文件规则之前，首条命中生效。grant 通过 host+scheme+port 精确匹配（部分条目额外带 tag_any）。静态策略对所有特殊用途段显式 deny，并以 default deny 收尾。",
  "cases": [
    {
      "id": "rebind-first-good-then-bad-second-run-uses-fresh-snapshot",
      "url": "http://rebind-public-then-meta.test/",
      "grants": [
        {
          "id": "g-rebind-host",
          "host": "rebind-public-then-meta.test",
          "scheme": "http",
          "port": 80,
          "records": [
            "203.0.113.10"
          ],
          "note": "脚本首帧 203.0.113.10(documentation) 被精确 grant 放行；连接固定在该快照。"
        }
      ],
      "expect_run_1": {
        "verdict": "allow",
        "status": "completed",
        "pinned_ip": "203.0.113.10",
        "single_resolution": true,
        "note": "grant 精确放行该 host；文档地址不产生真实外联时连接会在 TCP 阶段失败，但策略与 pinning 断言成立。集成场景用指向 127.0.0.1 的 grant 版本。"
      },
      "expect_run_2_fresh_kernel_same_resolver": {
        "verdict": "deny",
        "failure_kind": "policy_denied",
        "failure_reason": "ip.blocked",
        "connect_attempts": 0,
        "denied_ip": "169.254.169.254",
        "note": "脚本推进到第二帧返回元数据地址：策略拒绝。系统绝不能在同一跳内二次解析以‘换回好地址’。"
      }
    },
