# Example configuration for local runs. Copy to .env or `source` it before
# starting the binaries. Every value below is a local synthetic dependency.

# Controller desired-state API
RC_HTTP_ADDR=127.0.0.1:8080

# SQLite database (created automatically). Relative paths are resolved from
# the working directory; WAL mode and a busy timeout are set via DSN pragmas.
RC_DB_DSN=file:data/controller.db?cache=shared&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)

# Base URL of the actual resource service
RC_EXTERNAL_URL=http://127.0.0.1:8090

# Reconcile loop knobs
RC_WORKERS=2
RC_RESYNC_INTERVAL=5s
RC_BACKOFF_BASE=200ms
RC_BACKOFF_MAX=10s

# Actual resource service (fault-injectable fake cloud)
FAKE_HTTP_ADDR=127.0.0.1:8090
