# 复制为 .env 或通过 `set -a; source configs/dev.env` 加载；全部为本地合成配置，无外部账号
SMT_DB_PATH=data/smt.db
SMT_SIGNING_KEY_PATH=configs/dev_signing_key.pem
# 也可直接注入 32 字节 Ed25519 私钥的 hex（优先级高于密钥文件）；留空则自动生成开发密钥
SMT_SIGNING_KEY_HEX=
SMT_KEY_LEN=32
SMT_DEPTH=256
SMT_HOST=127.0.0.1
SMT_PORT=8080
# 日志/诊断中的敏感数据脱敏（值永不打印，键只留指纹）
SMT_LOG_REDACT=1
