{
  "name": "counter",
  "variables": [
    {"name": "x", "type": "int", "lo": 0, "hi": 3}
  ],
  "init": {"state": {"x": 0}},
  "terminal": "x == 3",
  "transitions": [
    {"name": "inc", "guard": "x < 3", "assign": [{"target": "x", "expr": "x + 1"}]},
    {"name": "reset", "guard": "x > 0", "assign": [{"target": "x", "value": 0}]}
  ]
}
