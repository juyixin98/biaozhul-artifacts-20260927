{
  "name": "s3_leave_and_rejoin",
  "summary": "One member leaving while another remains must not delete the group; when the last member leaves the FIRST group-specific query is sent immediately (RFC 3376); a rejoin between the 2nd and 3rd query cancels the remainder of the sequence; a later unanswered leave runs all three queries and deletes at the exact leave+LMQC*LMQI boundary.",
  "iface": "eth0",
  "group": "239.10.20.30",
  "timing_override": {
    "query_interval_ms": 1000000,
    "query_response_interval_ms": 200,
    "group_membership_interval_ms": 100000,
    "last_member_query_interval_ms": 100,
    "last_member_query_count": 3
  },
  "members": [
    {"name": "hostA", "addr": "192.0.2.31", "general_delay_ms": 50, "lmq_delay_ms": 90},
    {"name": "hostB", "addr": "192.0.2.32", "general_delay_ms": 60, "lmq_delay_ms": 90}
  ],
  "events": [
    {"at_ms": 100, "kind": "report", "member": "hostA", "request_id": "join-A"},
    {"at_ms": 200, "kind": "report", "member": "hostB", "request_id": "join-B"},
    {"at_ms": 500, "kind": "leave", "member": "hostA", "request_id": "leave-A-1"},
    {"at_ms": 700, "kind": "checkpoint", "request_id": "cp-700"},
    {"at_ms": 1000, "kind": "leave", "member": "hostB", "request_id": "leave-B"},
    {"at_ms": 1150, "kind": "report", "member": "hostA", "request_id": "rejoin-A"},
    {"at_ms": 1500, "kind": "checkpoint", "request_id": "cp-1500"},
    {"at_ms": 2000, "kind": "leave", "member": "hostA", "request_id": "leave-A-2"},
    {"at_ms": 2299, "kind": "checkpoint", "request_id": "cp-2299"},
    {"at_ms": 2300, "kind": "checkpoint", "request_id": "cp-2300"}
  ],
  "drop_rules": [],
  "until_ms": 2600,
  "assertions": [
    {"id": "S3-A-leave-group-retained", "check": "diag_matches",
     "target": {"at_ms": 500, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "member_left_group_retained",
                "members": ["hostB"]}},
    {"id": "S3-present-at-700", "check": "present_at", "at_ms": 700,
     "iface_p": "eth0", "group_p": "239.10.20.30"},
    {"id": "S3-no-gsq-before-last-leave", "check": "count_packets",
     "packet": "QUERY_GROUP", "at_ms_count": 999, "want": 0},
    {"id": "S3-B-leave-starts-lmq", "check": "diag_matches",
     "target": {"at_ms": 1000, "member": "hostB", "verdict": "ACCEPTED",
                "reason": "last_member_query_started", "members": []}},
    {"id": "S3-gsq1-immediate", "check": "diag_matches",
     "target": {"at_ms": 1000, "verdict": "ACCEPTED",
                "reason": "group_specific_query_emitted"}},
    {"id": "S3-gsq2", "check": "diag_matches",
     "target": {"at_ms": 1100, "verdict": "ACCEPTED",
                "reason": "group_specific_query_emitted"}},
    {"id": "S3-rejoin-cancels-gsq3", "check": "diag_matches",
     "target": {"at_ms": 1150, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "report_during_lmq", "members": ["hostA"]}},
    {"id": "S3-present-at-1500", "check": "present_at", "at_ms": 1500,
     "iface_p": "eth0", "group_p": "239.10.20.30"},
    {"id": "S3-gsq-count-first-sequence", "check": "count_packets",
     "packet": "QUERY_GROUP", "at_ms_count": 1999, "want": 2},
    {"id": "S3-A2-leave-starts-new-lmq", "check": "diag_matches",
     "target": {"at_ms": 2000, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "last_member_query_started", "members": []}},
    {"id": "S3-gsq3-immediate", "check": "diag_matches",
     "target": {"at_ms": 2000, "verdict": "ACCEPTED",
                "reason": "group_specific_query_emitted"}},
    {"id": "S3-gsq4", "check": "diag_matches",
     "target": {"at_ms": 2100, "verdict": "ACCEPTED",
                "reason": "group_specific_query_emitted"}},
    {"id": "S3-gsq5", "check": "diag_matches",
     "target": {"at_ms": 2200, "verdict": "ACCEPTED",
                "reason": "group_specific_query_emitted"}},
    {"id": "S3-present-at-2299", "check": "present_at", "at_ms": 2299,
     "iface_p": "eth0", "group_p": "239.10.20.30"},
    {"id": "S3-absent-at-2300-boundary", "check": "absent_at", "at_ms": 2300,
     "iface_p": "eth0", "group_p": "239.10.20.30"},
    {"id": "S3-deletion-confirmed", "check": "diag_matches",
     "target": {"at_ms": 2300, "verdict": "TIMEOUT",
                "reason": "last_member_query_confirmed"}},
    {"id": "S3-total-gsq", "check": "count_packets",
     "packet": "QUERY_GROUP", "want": 5},
    {"id": "S3-retention-100to2300", "check": "interval_equals",
     "iface_p": "eth0", "group_p": "239.10.20.30",
     "start_ms": 100, "end_ms": 2300}
  ]
}
