{
  "name": "s1_interleaved_reports",
  "summary": "Two members on one LAN join alternately; general queries elicit delayed reports and IGMPv2 report suppression; the forwarding entry is retained across the membership interval and old-round answers never overwrite the active generation.",
  "iface": "eth0",
  "group": "239.1.2.3",
  "timing_override": {
    "query_interval_ms": 1000000,
    "query_response_interval_ms": 200,
    "group_membership_interval_ms": 260,
    "last_member_query_interval_ms": 100,
    "last_member_query_count": 2
  },
  "members": [
    {"name": "hostA", "addr": "192.0.2.11",
     "general_delays_ms": [40, 20, 40, 20], "lmq_delay_ms": 30},
    {"name": "hostB", "addr": "192.0.2.12",
     "general_delays_ms": [20, 40, 20, 40], "lmq_delay_ms": 20}
  ],
  "events": [
    {"at_ms": 100, "kind": "report", "member": "hostA", "request_id": "join-A"},
    {"at_ms": 150, "kind": "report", "member": "hostB", "request_id": "join-B"},
    {"at_ms": 200, "kind": "checkpoint", "request_id": "cp-200"},
    {"at_ms": 250, "kind": "force_query", "request_id": "gq-1"},
    {"at_ms": 450, "kind": "force_query", "request_id": "gq-2"},
    {"at_ms": 600, "kind": "checkpoint", "request_id": "cp-600"},
    {"at_ms": 650, "kind": "force_query", "request_id": "gq-3"},
    {"at_ms": 850, "kind": "force_query", "request_id": "gq-4"}
  ],
  "drop_rules": [],
  "until_ms": 900,
  "assertions": [
    {"id": "S1-A-present-at-200", "check": "present_at", "at_ms": 200,
     "iface_p": "eth0", "group_p": "239.1.2.3"},
    {"id": "S1-A-created", "check": "diag_matches",
     "target": {"at_ms": 100, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "membership_created", "deadline_ms": 360,
                "members": ["hostA"]}},
    {"id": "S1-B-join", "check": "diag_matches",
     "target": {"at_ms": 150, "member": "hostB", "verdict": "ACCEPTED",
                "reason": "membership_refreshed", "deadline_ms": 410,
                "members": ["hostA", "hostB"]}},
    {"id": "S1-round1-B-reports-first", "check": "diag_matches",
     "target": {"at_ms": 270, "member": "hostB", "verdict": "ACCEPTED",
                "reason": "membership_refreshed", "gen_active": 1, "gen_applied": 1,
                "members": ["hostA", "hostB"], "deadline_ms": 530}},
    {"id": "S1-round1-A-suppressed", "check": "diag_matches",
     "target": {"at_ms": 290, "member": "hostA", "verdict": "SUPPRESSED",
                "reason": "report_suppressed", "gen_active": 1, "gen_applied": 1}},
    {"id": "S1-round2-A-reports-first", "check": "diag_matches",
     "target": {"at_ms": 470, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "membership_refreshed", "gen_active": 2, "gen_applied": 2,
                "members": ["hostA", "hostB"], "deadline_ms": 730}},
    {"id": "S1-round2-B-suppressed", "check": "diag_matches",
     "target": {"at_ms": 490, "member": "hostB", "verdict": "SUPPRESSED",
                "reason": "report_suppressed", "gen_active": 2, "gen_applied": 2}},
    {"id": "S1-suppressed-count", "check": "count_packets",
     "verdict": "SUPPRESSED", "want": 4},
    {"id": "S1-present-at-600", "check": "present_at", "at_ms": 600,
     "iface_p": "eth0", "group_p": "239.1.2.3"},
    {"id": "S1-round3-B-reports", "check": "diag_matches",
     "target": {"at_ms": 670, "member": "hostB", "verdict": "ACCEPTED",
                "reason": "membership_refreshed", "gen_active": 3, "gen_applied": 3,
                "deadline_ms": 930}},
    {"id": "S1-round3-A-suppressed", "check": "diag_matches",
     "target": {"at_ms": 690, "member": "hostA", "verdict": "SUPPRESSED",
                "reason": "report_suppressed", "gen_active": 3, "gen_applied": 3}},
    {"id": "S1-round4-A-refreshes", "check": "diag_matches",
     "target": {"at_ms": 870, "member": "hostA", "verdict": "ACCEPTED",
                "reason": "membership_refreshed", "gen_active": 4, "gen_applied": 4,
                "deadline_ms": 1130}},
    {"id": "S1-general-query-count", "check": "count_packets",
     "packet": "QUERY_GENERAL", "iface_p": "eth0", "want": 4},
    {"id": "S1-retention-open", "check": "interval_equals",
     "iface_p": "eth0", "group_p": "239.1.2.3",
     "start_ms": 100, "end_ms": 0},
    {"id": "S1-still-present-at-900", "check": "present_at", "at_ms": 900,
     "iface_p": "eth0", "group_p": "239.1.2.3"}
  ]
}
