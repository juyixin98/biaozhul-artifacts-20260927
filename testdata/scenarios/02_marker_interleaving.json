{
  "name": "02_marker_interleaving",
  "description": "Two snapshot ids s1 and s2 run in sequence with overlapping storage and a marker/traffic interleaving. Each snapshot has its own in-flight transfer (t1 for s1, t2 for s2); the sessions must be fully isolated and each must conserve 300. No global pause: every gate holds a single directed channel only.",
  "nodes": [
    {"id": "n1", "address": ""},
    {"id": "n2", "address": ""},
    {"id": "n3", "address": ""}
  ],
  "initial_balance": {"n1": 100, "n2": 100, "n3": 100},
  "conserve_total": 300,
  "steps": [
    {"action": "pin", "node": "n2", "peer": "n1"},
    {"action": "transfer", "node": "n2", "to": "n1", "tx_id": "t1", "amount": 30},
    {"action": "start_snapshot", "node": "n1", "snap_id": "s1"},
    {"action": "release", "node": "n2", "peer": "n1"},
    {"action": "await_complete", "node": "n1", "snap_id": "s1"},

    {"action": "pin", "node": "n3", "peer": "n2"},
    {"action": "start_snapshot", "node": "n3", "snap_id": "s2",
     "note": "markers are enqueued FIRST while n3->n2 is pinned"},
    {"action": "transfer", "node": "n3", "to": "n2", "tx_id": "t2", "amount": 20,
     "note": "t2 queued BEHIND the s2 marker on the FIFO channel, so it is post-cut"},
    {"action": "release", "node": "n3", "peer": "n2"},
    {"action": "await_complete", "node": "n3", "snap_id": "s2"},

    {"action": "expect_snapshot", "node": "n1", "snap_id": "s1"},
    {"action": "expect_snapshot", "node": "n3", "snap_id": "s2"},
    {"action": "await_settled"}
  ],
  "expect": {
    "s1": {
      "complete": true,
      "local": {"n1": 100, "n2": 70, "n3": 100},
      "channels": {"n2->n1": [{"tx_id": "t1", "amount": 30}]},
      "global_total": 270,
      "in_flight_sum": 30
    },
    "s2": {
      "complete": true,
      "local": {"n1": 130, "n2": 90, "n3": 80},
      "channels": {},
      "global_total": 300,
      "in_flight_sum": 0,
      "final_balances": {"n1": 130, "n2": 90, "n3": 80}
    }
  }
}
