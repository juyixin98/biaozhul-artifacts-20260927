# ── 匿名化风险检查服务配置 ─────────────────────────────────────────────
# 复制为 .env 后按需修改。所有变量带 ANON_ 前缀。

# Fernet 密钥（用 `python -m app.cli gen-key` 生成）。
# 生产/持久化场景必须设置；留空时仅当 ANON_ALLOW_EPHEMERAL_KEY=1 才启动，
# 且生成的一次性密钥在重启后无法解密旧数据（仅限本地合成/测试）。
ANON_ENCRYPTION_KEY=

# 审计链 HMAC 密钥；留空时从 ANON_ENCRYPTION_KEY 派生，
# 若两者皆空则使用一次性随机密钥（重启后旧审计链无法校验）。
ANON_AUDIT_SIGNING_KEY=

# 仅本地/测试置 1；真实部署保持 0 或不设置。
ANON_ALLOW_EPHEMERAL_KEY=0

ANON_HOST=127.0.0.1
ANON_PORT=8000

ANON_DATABASE_PATH=data/anon.db
ANON_AUDIT_LOG_PATH=logs/audit.jsonl
# 留空=结构化日志输出到 stderr；设为文件则写文件
ANON_APP_LOG_PATH=logs/app.jsonl

# 输入上限
ANON_MAX_ROWS=1000
ANON_MAX_COLUMNS=32
ANON_MAX_QI=8
ANON_MAX_HIERARCHY_HEIGHT=8
ANON_MAX_CLASSES_RETURNED=500
