# FM-index service startup configuration (copy to .env and source, or export
# these in your shell). Every variable is optional; defaults are shown.

# Directory for catalog.json and *.fm index files (created on demand).
FM_DATA_DIR=./data

# Listen address for the Axum HTTP server.
FM_BIND=127.0.0.1:8080

# Maximum accepted text size per index, in bytes (HTTP 413 above this).
FM_MAX_TEXT_BYTES=4194304

# SA sample interval used when a create request omits sample_interval.
# Smaller = more samples = faster locate, larger files. Must be 1..=65535.
FM_DEFAULT_SAMPLE_INTERVAL=16

# If set, one JSON line per request is appended here as requests.jsonl
# (run id, interval, hit count, error category) for post-hoc replay.
FM_LOG_DIR=./logs

# tracing filter
RUST_LOG=fm_index_svc=info,tower_http=info
