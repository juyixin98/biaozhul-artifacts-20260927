# Copy to .env or export in your shell. All defaults are local-only.
DICTSVC_SQLITE_PATH=data/dictsvc.db
DICTSVC_LOG_DIR=data/logs
# Default per-request target index width: 8 | 16 | 32 | 64
DICTSVC_DEFAULT_WIDTH=8
# Behavior when cardinality exceeds target width: reject | expand
DICTSVC_DEFAULT_WIDTH_POLICY=reject
DICTSVC_LOG_LEVEL=INFO
PORT=8000
