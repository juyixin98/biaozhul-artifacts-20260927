# Audit Commitment Service configuration (example)
# Copy to .env and adjust. Every variable is prefixed AUDIT_.

# SQLite database file (private salts are stored ONLY here, locally)
AUDIT_DB_PATH=./data/audit.db
# Runtime/test log directory
AUDIT_LOG_DIR=./logs
AUDIT_LOG_LEVEL=INFO

# Commitment policy
AUDIT_DIGEST=sha256
AUDIT_DEFAULT_SALT_BYTES=16
# Unsalted commitments are rejected unless this is explicitly set to true.
AUDIT_ALLOW_UNSALTED=false
