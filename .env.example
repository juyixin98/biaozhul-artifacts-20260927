# Copy to .env and adjust. All values have local development defaults (see src/arrowzero/config.py).
# SQLite database used by the metadata transaction layer.
ARROWZERO_DB_PATH=data/arrowzero.db
# Where structured JSONL run logs are written.
ARROWZERO_LOG_PATH=logs/arrowzero.jsonl
# Maximum number of imported arrays kept in the in-memory handle registry.
ARROWZERO_REGISTRY_CAPACITY=128
# Bind address for the FastAPI service.
ARROWZERO_HOST=127.0.0.1
ARROWZERO_PORT=8000
